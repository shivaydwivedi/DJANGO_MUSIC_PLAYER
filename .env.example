# Local development defaults. Use True or False for boolean values.
DEBUG=True

# Required when DEBUG=False. Keep real secrets only in your local .env.
# Generate a production value with:
# .\.venv-django52\Scripts\python.exe -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-secret-key

# Comma-separated hostnames. Local defaults are used when omitted in DEBUG=True.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Production database. Leave blank for local SQLite development.
# Example format only; never commit real credentials:
# DATABASE_URL=postgresql://sonica_user:replace-with-password@db.example.com:5432/sonica
DATABASE_URL=
DATABASE_CONN_MAX_AGE=60
DATABASE_SSL_REQUIRE=False

# Platform-provided port for production start commands.
PORT=8000

# Optional comma-separated absolute origins, including scheme.
# Example: https://sonica.example.com,https://www.sonica.example.com
CSRF_TRUSTED_ORIGINS=

# Optional Google sign-in UI flag. Requires a real SocialApp in Django admin.
ENABLE_GOOGLE_AUTH=False

# Production HTTPS security. Keep HSTS disabled until HTTPS is verified.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
X_FRAME_OPTIONS=DENY
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# Reverse-proxy trust. Enable only behind a trusted proxy that strips and sets
# X-Forwarded-Proto correctly.
TRUST_X_FORWARDED_PROTO=False
USE_X_FORWARDED_HOST=False

# Upload size limits in bytes.
SONICA_MAX_AUDIO_UPLOAD_SIZE=20971520
SONICA_MAX_COVER_UPLOAD_SIZE=5242880
